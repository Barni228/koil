    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- "Open in Koil" on the folders selected in Finder (only there:
         NSRequiredContext, without which macOS also has it off at first),
         in their right-click menu's Services and the Services menu
         (cpp/finder_mac.mm). Taking folders puts it under Files and
         Folders in System Settings; one that takes nothing is under
         General (NSServiceCategory doesn't change that), and isn't in
         right-click menus. With nothing selected, macOS turns it off.
         macOS handles its shortcut, launching Koil if it isn't running.
         NSKeyEquivalent is a letter, with Command (and Shift if it's
         uppercase), or modifiers and a key as pbs keeps them (^ Control,
         ~ Option, $ Shift, @ Command: Keka's ^$K is ⌃⇧K). It's ⌃⇧K, which
         Finder doesn't use (⌘K and ⇧⌘K are its), nor do text fields (⌃K
         deletes to the line's end in them, and a service's shortcut comes
         first; Finder's rename field may offer the folder). Keka's "Send to
         Keka" is ⌃⇧K too. The user changes it in System Settings (see the
         README), which keeps it in pbs's preferences (by the bundle ID,
         NSMenuItem and NSMessage, which Koil's Settings reads it by). -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Open in Koil</string>
            </dict>
            <key>NSMessage</key>
            <string>openFolder</string>
            <key>NSPortName</key>
            <string>Koil</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.folder</string>
            </array>
            <key>NSKeyEquivalent</key>
            <dict>
                <key>default</key>
                <string>^$k</string>
            </dict>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSApplicationIdentifier</key>
                <array>
                    <string>com.apple.finder</string>
                </array>
            </dict>
        </dict>
    </array>
    <!-- Koil opens any file that is UTF-8 text, as an Alternate: it shows
         in Open With but isn't made the default of a type another app
         opens. public.text is what text and source code macOS knows are;
         public.data matches only files of that type itself: ones with no
         extension (empty too) and dotfiles (.envrc), not pictures. A file
         whose extension macOS doesn't know (.toml) has a dyn.* type that
         no claim on a type it conforms to matches (public.data,
         public.item), so those extensions are claimed one by one, as VS
         Code and Zed do; Koil is then the default of one only if no other
         app claims it. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Text</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.text</string>
                <string>public.data</string>
            </array>
        </dict>
